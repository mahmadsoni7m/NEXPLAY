{
  "name": "nexplay-server",
  "version": "1.0.0",
  "private": true,
  "description": "NEXPLAY online multiplayer server (HTTP + WebSocket)",
  "main": "dist/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "test": "tsc -p tsconfig.json && node --test dist/tests/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chess.js": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.4"
  }
}
